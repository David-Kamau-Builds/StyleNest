# ============================================================
# .gitignore for the terraform/ directory
# ============================================================

# Your actual secret values — NEVER commit this!
terraform.tfvars

# Terraform state files — contain sensitive resource info
*.tfstate
*.tfstate.backup
.terraform.tfstate.lock.info

# Terraform working directory
.terraform/
.terraform.lock.hcl

# Crash log files
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
